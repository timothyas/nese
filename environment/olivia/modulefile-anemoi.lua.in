-- -*- lua -*-
-- nese-anemoi: custom Apptainer image (NGC arm64 PyTorch + anemoi suite + nese layer).
-- Generated by environment/olivia/build-anemoi-env.sh on @VERSION@ from @BASE_SIF@.

help([[
The `nese-anemoi` GPU environment: the NVIDIA NGC PyTorch container (arm64,
torch 2.8 / CUDA 12.9 / Python 3.12) extended with the anemoi suite and editable
anemoi-core (graphs/models/training), nese-inference, nese-training.

Runs on Olivia `accel` (GH200) nodes only -- the image is aarch64.

This module is THIN: it sets NESE_ANEMOI_SIF and the Olivia HTTP proxy and puts
NOTHING on PATH (no python / anemoi-training shadowing). Run tools explicitly:

  apptainer exec --nv --bind /cluster "$NESE_ANEMOI_SIF" python ...
  apptainer exec --nv --bind /cluster "$NESE_ANEMOI_SIF" anemoi-training --help

Single-node training (GH200 NVLink-C2C) needs only --nv. Multi-node NCCL over
Slingshot needs the host libfabric / NCCL / aws-ofi-nccl bind list -- see
environment/olivia/README.md and
environment/olivia/examples/anemoi-train-multinode.slurm.

Editable source under /cluster/projects/... is bind-mounted, so .py edits are
live. Rebuild only on dependency / entry-point / version changes, or after editing
environment/olivia/{requirements-anemoi.txt,nese-anemoi.def.in}:
  bash environment/olivia/build-anemoi-env.sh   # from an aarch64 accel node
]])

whatis("Name        : nese-anemoi")
whatis("Description : Apptainer NGC PyTorch + anemoi suite for NESE training/inference")
whatis("Environment : @PREFIX@")

-- Both envs would otherwise fight over PATH / proxy / NESE_* expectations.
conflict("nese")

setenv("NESE_ANEMOI_ENV_PREFIX", "@PREFIX@")
setenv("NESE_ANEMOI_SIF", "@SIF@")

-- Olivia reaches the internet (login and compute nodes alike) only through this
-- proxy. Reverted on `module unload`.
setenv("http_proxy",  "http://10.63.2.48:3128/")
setenv("https_proxy", "http://10.63.2.48:3128/")
setenv("HTTP_PROXY",  "http://10.63.2.48:3128/")
setenv("HTTPS_PROXY", "http://10.63.2.48:3128/")
setenv("no_proxy", "localhost,127.0.0.1,::1")
setenv("NO_PROXY", "localhost,127.0.0.1,::1")

-- torch.compile's triton backend looks for libcuda.so, which the NGC image ships
-- only as libcuda.so.1; without this, compiled kernels (e.g. flex_attention)
-- fail to lower. APPTAINERENV_ forwards it into the container.
setenv("APPTAINERENV_TRITON_LIBCUDA_PATH", "/usr/local/cuda/compat/lib/libcuda.so.1")
